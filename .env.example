# TypeSafe / Jev Decision Layer Configuration
# Leave blank to operate in deterministic rule-based review mode (app will work fully)
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest

# Database Connection (Docker Compose default or Supabase/Postgres)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/shadepilot

# Application Metadata
NEXT_PUBLIC_APP_NAME=ShadePilot
